.home {
    padding: 40rpx 32rpx;
    min-height: 100vh;
    background: #f5f5f7;
    box-sizing: border-box;
}

.brand {
    text-align: center;
    margin: 40rpx 0 60rpx;
}

.brand-title {
    display: block;
    font-size: 44rpx;
    font-weight: bold;
    color: #333;
}

.brand-sub {
    display: block;
    font-size: 24rpx;
    color: #999;
    margin-top: 12rpx;
}

.entry-list {
    display: flex;
    flex-direction: column;
    gap: 28rpx;
}

.entry {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 20rpx;
    padding: 36rpx 32rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    border-left: 8rpx solid #667eea;
}

.entry-native {
    border-left-color: #667eea;
}

.entry-basic {
    border-left-color: #43e97b;
}

.entry-advanced {
    border-left-color: #fa709a;
}

.entry-index {
    width: 56rpx;
    height: 56rpx;
    line-height: 56rpx;
    text-align: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 28rpx;
    font-weight: bold;
    flex-shrink: 0;
}

.entry-body {
    flex: 1;
    margin: 0 24rpx;
    display: flex;
    flex-direction: column;
}

.entry-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.entry-desc {
    font-size: 24rpx;
    color: #888;
    margin-top: 10rpx;
    line-height: 1.5;
}

.entry-arrow {
    font-size: 44rpx;
    color: #ccc;
    flex-shrink: 0;
}

.entry:active {
    transform: scale(0.98);
    opacity: 0.9;
}
