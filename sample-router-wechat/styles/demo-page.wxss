/**
 * 演示页共享样式
 *
 * native/methods、basic/index、advanced/index 三个演示页共用的「状态栏 +
 * 提示条 + 演示卡片 + 代码块 + 运行按钮 + 操作日志」样式。各页通过
 * @import 引入，再按需追加页面特有样式（advanced 的模块分组配色等）。
 */

.container {
    padding: 24rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
}

.status {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.status-label {
    font-size: 26rpx;
    color: #868e96;
    margin-right: 20rpx;
}

.status-val {
    font-size: 28rpx;
    color: #1971c2;
    font-weight: 600;
}

.tip {
    background: #e7f5ff;
    border-left: 6rpx solid #1971c2;
    border-radius: 8rpx;
    padding: 20rpx 24rpx;
    margin-bottom: 24rpx;
    font-size: 25rpx;
    color: #495057;
    line-height: 1.6;
}

.tip .hl {
    color: #1971c2;
    font-weight: 600;
}

.demo-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.demo-head {
    display: flex;
    align-items: center;
    margin-bottom: 14rpx;
}

.demo-no {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    background: #1971c2;
    color: #fff;
    border-radius: 50%;
    font-size: 24rpx;
    margin-right: 16rpx;
}

.demo-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #212529;
    font-family: monospace;
}

.demo-desc {
    font-size: 25rpx;
    color: #868e96;
    margin-bottom: 18rpx;
    line-height: 1.5;
}

.code-block {
    background: #212529;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 22rpx;
    overflow-x: auto;
}

.code-block text {
    color: #94d82d;
    font-family: monospace;
    font-size: 24rpx;
    white-space: pre;
    line-height: 1.6;
}

.run-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    border-radius: 12rpx;
    font-size: 28rpx;
}

.run-btn:active {
    opacity: 0.85;
}

.log-section {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.log-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.log-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
}

.clear-btn {
    font-size: 24rpx;
    color: #fa5252;
}

.logs {
    max-height: 400rpx;
}

.log-item {
    font-size: 24rpx;
    color: #495057;
    font-family: monospace;
    padding: 8rpx 0;
    border-bottom: 1rpx solid #f1f3f5;
}

.log-empty {
    font-size: 24rpx;
    color: #adb5bd;
    text-align: center;
    padding: 30rpx 0;
}
