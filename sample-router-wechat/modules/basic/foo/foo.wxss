.container {
    padding: 40rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
}

.debug-info {
    background: #f8f9fa;
    border: 1rpx solid #dee2e6;
    border-radius: 8rpx;
    padding: 20rpx;
    margin: 20rpx 0;
    font-size: 24rpx;
    color: #495057;
    font-family: monospace;
    word-break: break-all;
}

.page-title {
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
    text-align: center;
    margin-bottom: 40rpx;
}

.params-section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #495057;
    margin-bottom: 20rpx;
    border-bottom: 2rpx solid #e9ecef;
    padding-bottom: 10rpx;
}

.param-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15rpx 0;
    border-bottom: 1rpx solid #f1f3f4;
}

.param-item:last-child {
    border-bottom: none;
}

.param-key {
    font-weight: bold;
    color: #007bff;
    font-family: monospace;
    font-size: 28rpx;
}

.param-value {
    color: #28a745;
    font-family: monospace;
    font-size: 28rpx;
    max-width: 400rpx;
    word-break: break-all;
}

.no-params {
    text-align: center;
    color: #6c757d;
    font-style: italic;
    padding: 40rpx;
}

.action-section {
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.action {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 25rpx 40rpx;
    margin: 15rpx 0;
    border-radius: 8rpx;
    text-align: center;
    font-size: 30rpx;
    box-shadow: 0 4rpx 8rpx rgba(102, 126, 234, 0.3);
    transition: all 0.3s ease;
}

.action:active {
    transform: scale(0.98);
    box-shadow: 0 2rpx 4rpx rgba(102, 126, 234, 0.2);
}

button {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    color: white;
    border: none;
    padding: 25rpx 40rpx;
    margin: 15rpx 0;
    border-radius: 8rpx;
    font-size: 30rpx;
    box-shadow: 0 4rpx 8rpx rgba(79, 172, 254, 0.3);
}

button:active {
    transform: scale(0.98);
    box-shadow: 0 2rpx 4rpx rgba(79, 172, 254, 0.2);
}