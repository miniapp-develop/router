<view class="container">
    <route />

    <view class="status">
        <text class="status-label">最近操作</text>
        <text class="status-val">{{lastAction || '暂无'}}</text>
    </view>

    <view class="tip">
        级联使用：<text class="hl">appRouter.use(name, childRouter)</text> 注册子路由，
        <text class="hl">name 数组</text>按层消费——首段命中子路由，剩余段在其内部继续解析。
        下方 <text class="hl amber">shop</text> 与 <text class="hl teal">game</text> 为两个同级子模块。
    </view>

    <view wx:for="{{modules}}" wx:for-item="mod" wx:key="key" class="mod-group mod-{{mod.accent}}">
        <view class="mod-head">
            <view class="mod-badge">{{mod.key}}</view>
            <text class="mod-title">{{mod.title}}</text>
        </view>
        <view class="mod-desc">{{mod.desc}}</view>

        <view wx:for="{{mod.demos}}" wx:for-item="demo" wx:key="key" class="demo-card">
            <view class="demo-head">
                <text class="demo-title">{{demo.title}}</text>
            </view>
            <view class="demo-desc">{{demo.desc}}</view>
            <view class="code-block"><text>{{demo.code}}</text></view>
            <button class="run-btn run-{{mod.accent}}" data-key="{{demo.key}}" bindtap="onRunTap">运行</button>
        </view>
    </view>

    <view class="log-section">
        <view class="log-head">
            <text class="log-title">操作日志</text>
            <text class="clear-btn" bindtap="onClearLogs">清空</text>
        </view>
        <scroll-view class="logs" scroll-y="true">
            <view wx:for="{{logs}}" wx:key="index" class="log-item">{{item}}</view>
            <view wx:if="{{logs.length === 0}}" class="log-empty">暂无操作日志</view>
        </scroll-view>
    </view>
</view>
