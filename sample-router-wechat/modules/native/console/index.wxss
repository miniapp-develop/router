.container {
    padding: 40rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
}

.debug-info {
    background: #fff;
    border: 1rpx solid #dee2e6;
    border-radius: 16rpx;
    padding: 30rpx;
    margin: 20rpx 0;
    font-size: 26rpx;
    color: #495057;
}

.row {
    display: flex;
    margin-bottom: 20rpx;
}

.label {
    color: #868e96;
    width: 120rpx;
    flex-shrink: 0;
}

.value {
    color: #212529;
    word-break: break-all;
}

.params-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    margin: 10rpx 0 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #e9ecef;
}

.param-row {
    display: flex;
    background: #f1f3f5;
    border-radius: 8rpx;
    padding: 16rpx 20rpx;
    margin-bottom: 12rpx;
    font-family: monospace;
}

.p-key {
    color: #1971c2;
    width: 220rpx;
    flex-shrink: 0;
    word-break: break-all;
}

.p-val {
    color: #e8590c;
    word-break: break-all;
}

.empty {
    color: #adb5bd;
    font-style: italic;
}

.raw-title {
    font-size: 26rpx;
    color: #868e96;
    margin: 24rpx 0 8rpx;
}

.raw-block {
    background: #212529;
    color: #94d82d;
    border-radius: 8rpx;
    padding: 20rpx;
    font-family: monospace;
    font-size: 24rpx;
    white-space: pre-wrap;
    word-break: break-all;
}

.back-btn {
    margin-top: 30rpx;
    background: #495057;
    color: #fff;
    border-radius: 12rpx;
}
