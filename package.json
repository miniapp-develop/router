{
    "name": "@mini-dev/router",
    "version": "0.2.0",
    "description": "a simple miniapp router",
    "miniprogram": "libs",
    "main": "libs/index.js",
    "files": [
        "libs"
    ],
    "scripts": {
        "test": "jest --coverage"
    },
    "jest": {
        "collectCoverageFrom": [
