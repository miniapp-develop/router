                "branches": 85,
                "functions": 90,
                "lines": 90
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+git@github.com:xesam/minidev-router.git"
    },
    "bugs": {
        "url": "https://github.com/xesam/minidev-router"
    },
    "homepage": "https://github.com/xesam/minidev-router",
    "devDependencies": {
        "jest": "^30.0.5"
    },
    "keywords": [],
    "author": "xesam",
    "license": "ISC"
}
